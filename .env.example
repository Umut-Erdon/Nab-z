# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. ".env" Git'e EKLENMEZ.

FLASK_ENV=development
SECRET_KEY=buraya-uzun-rastgele-bir-deger-yazin

# MySQL bağlantısı (geliştirme)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nabiz_user
DB_PASSWORD=degistirin
DB_NAME=nabiz_dev

# Test veritabanı (geliştirme verisinden AYRI olmalı; adı "_test" ile bitmelidir)
TEST_DB_NAME=nabiz_test

# Anonimlik: bir grup için sonuç gösterilmesi gereken en az yanıt sayısı
MIN_GROUP_SIZE=5

# Yapay zekâ (isteğe bağlı; boşsa kural tabanlı fallback kullanılır)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Giriş denemesi sınırı (aynı e-posta + IP)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# AI_PROVIDER=anthropic ise AI_API_KEY ve AI_MODEL doldurulmalıdır.
# true olursa maskelenmiş serbest metin örnekleri de dış sağlayıcıya gönderilir (varsayılan: false;
# yalnızca toplulaştırılmış metrikler gider). KVKK değerlendirmesi olmadan açmayın.
AI_SEND_TEXT=false

